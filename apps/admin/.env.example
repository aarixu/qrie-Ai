VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# The environment this build is for: HOSTED, STAGING, DEMO or TEST. It must match
# what the database says (admin.environment()). Every write sends this value; the
# console refuses to send a write when the two differ, and so does the database.
# Reading still works, so you can see what you are pointed at.
# Never put the service-role (secret) key above: the build scans its own output
# and fails, and the console refuses to start with it.
VITE_ADMIN_ENV=
