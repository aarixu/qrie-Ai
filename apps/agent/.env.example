# Copy to apps/agent/.env and fill in. The .env file is never committed.
# The three LIVEKIT_ values are the same ones the worker and the token server
# both use; see README.md for what they are on a local livekit-server.

# Websocket URL of the LiveKit server, e.g. ws://host:7880 or wss://<project>.livekit.cloud
LIVEKIT_URL=

# LiveKit API key.
LIVEKIT_API_KEY=

# LiveKit API secret. Signs join tokens — it must never reach a browser.
LIVEKIT_API_SECRET=

# Gemini API key for the live voice model. GEMINI_API_KEY is accepted instead.
GOOGLE_API_KEY=

# Interface the token server binds to. Blank = 127.0.0.1 (loopback only).
TOKEN_SERVER_HOST=

# Port the token server listens on. Blank = 7890.
TOKEN_SERVER_PORT=

# The ONE browser origin allowed to call the token server. Blank = http://localhost:5173.
# "*" is refused at startup: it would let any site mint a join token.
TOKEN_SERVER_ORIGIN=
