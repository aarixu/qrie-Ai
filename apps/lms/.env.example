# The teacher app's build settings. Copy to .env.local (git keeps it out) and
# fill in. Vite puts VITE_ values into the built app, where anyone can read
# them: never put a secret here.

# The hosted project. With both set, the app is built for it
# (src/lib/backend.ts); with either empty, for the demo school. The key is the
# project's anon or publishable key, never the service-role or a secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. The relay, for Draft with AI on the hosted project, like
# https://<project-ref>.supabase.co/functions/v1/relay. Not set, Draft with AI
# is off.
# VITE_QRIE_RELAY_URL=

# Optional, the demo school only: where `npm run demo` serves it. Not set,
# http://127.0.0.1:54400.
# VITE_QRIE_DEMO_URL=http://192.168.1.5:54400

# Optional. The email address the privacy notice (/privacy) gives for
# questions and requests about people's data. Not set, or not an email
# address, the notice says to ask the school office.
# VITE_QRIE_PRIVACY_CONTACT=privacy@example.com
