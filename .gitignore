.claude/settings.local.json
# A downloaded Blender install, not our code. This line used to read
# `tools/bin/` and swept up every script beside it — including
# check-bundle-secrets.mjs, which is in the project's own verification
# routine and was therefore missing from every clone of this repo.
tools/bin/blender/
# livekit-server, downloaded on demand by tools/livekit. Never committed.
tools/livekit/bin/

# Voice samples for picking a tutor voice. Throwaway.
content/voices/
clone-source/

# RunPod MCP config carries the API key. Same rule as .env.local.
.mcp.json

# Throwaway patch scripts and one-off repairs.
.scratch/

# The .env file relay-secrets.mjs writes and deletes. Never committed.
.relay-secrets.*.env

# Google Cloud service account keys. A JSON in here is the credential that
# stands between a phone and somebody's Cloud balance — it is a Supabase
# secret and a local file, and it is never a commit.
.secrets/
*service-account*.json
*-serviceaccount.json

# Speech models, ~306 MB, fetched by tools/bin/fetch-speech-models.mjs.
# Downloadable artefacts, not source, and they would dwarf the repo.
content/models/
# The onnxruntime WASM binaries, copied out of node_modules by the same
# script. 39 MB of build output, not source.
content/wasm/

# A throwaway anonymous token, dropped so a dead measurement run is still
# recoverable from usage_event. Never committed.
tools/measure/last-session.json

# Probe output from a live measurement run. It holds a real Supabase session
# JWT, the project ref, the signing key id and a real user id — a credential,
# and expiry is not a defence for any of the other three. Ignored by pattern
# rather than by name because the next run drops a new one at the next number,
# and one `git add .` is all it would take.
probe*.json

# Piper voices and the samples made from them. Each voice is 63 MB and one
# line of `piper.download_voices` brings it back; see tools/speech/README.md.
tools/speech/voices/
tools/speech/samples/
