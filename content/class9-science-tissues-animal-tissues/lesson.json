        {
          "term": "Stratified Squamous",
          "meaning": "Skin surface (prevents abrasion and mechanical injury)"
        },
        {
          "term": "Ciliated Columnar",
          "meaning": "Respiratory tract (cilia push mucus forward)"
        },
        {
          "term": "Cuboidal",
          "meaning": "Kidney tubules and salivary gland ducts (mechanical support)"
        }
