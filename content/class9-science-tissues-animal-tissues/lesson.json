      "heading": "Four Primary Animal Tissues",
      "items": [
        {
          "term": "Epithelial tissue",
          "meaning": "Protective covering and lining sheets"
        },
        {
          "term": "Connective tissue",
          "meaning": "Binds, supports, and transports substances"
        },
        {
          "term": "Muscular tissue",
          "meaning": "Contracts and relaxes to create movement"
        },
        {
          "term": "Nervous tissue",
          "meaning": "Transmits rapid electrical signals throughout the body"
