    {
      "id": "b2_5",
      "topic": "Aerobic Respiration in Mitochondria",
      "narration": "Which organelle is the site of aerobic respiration inside the cell?",
      "ask": {
        "question": "Which organelle is the site of aerobic respiration inside the cell?",
        "expect": "The mitochondrion (or mitochondria).",
        "hint": "Think of the organelle known as the powerhouse of the cell.",
        "whyProbe": {
          "askedAs": "open",
          "options": [
            {
              "text": "Mitochondria",
              "correct": true,
              "why": "Mitochondria contain the enzymes required for complete oxidation of pyruvate into carbon dioxide and water."
            },
            {
              "text": "Nucleus",
              "correct": false,
              "why": "The nucleus stores genetic material DNA, it does not carry out cellular respiration.",
              "followUp": "Which organelle is called the powerhouse of the cell?"
            },
            {
              "text": "Ribosome",
              "correct": false,
              "why": "Ribosomes synthesise proteins, they do not release energy from glucose.",
              "followUp": "Where are the oxidative enzymes that produce ATP located?"
            }
          ]
        },
        "workedExample": {
          "steps": [
            {
              "say": "Plants make food using sunlight in chloroplasts.",
              "line": "6CO2 + 6H2O -> C6H12O6 + 6O2"
            },
            {
              "say": "Cells break that food down using oxygen in mitochondria.",
              "line": "C6H12O6 + 6O2 -> 6CO2 + 6H2O + Energy"
            }
          ]
        },
        "alternates": [
          {
            "mode": "visual",
            "say": "Picture the mitochondrion as a furnace: glucose and oxygen go in, exhaust gases carbon dioxide and water vapor come out, and energy coins called ATP are minted.",
            "line": "Mitochondria = Cellular Furnace"
          },
          {
            "mode": "analogy",
            "say": "If glucose is a cheque of high value, mitochondria are the bank counter that cashes it into usable small currency notes called ATP.",
            "line": "Glucose -> Mitochondria -> 38 ATP"
          }
        ]
      },
