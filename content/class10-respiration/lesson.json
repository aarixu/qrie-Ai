      ],
      "frame": [
        "b1_0"
      ]
    },
    {
      "id": "b1_2",
      "topic": "Breathing versus Respiration",
      "narration": "Think about the last time you ran to catch a school bus or sprinted in PT period.",
      "show": [
        "b1_0",
        "b1__runner"
      ],
      "frame": [
        "b1_0",
        "b1__runner"
      ]
    },
    {
      "id": "b1_3",
      "topic": "Breathing versus Respiration",
      "narration": "Your chest heaved, taking in huge gulps of air. Why do our bodies need to take in oxygen during and after running?",
      "ask": {
        "question": "Why do our bodies need to take in oxygen during and after running?",
        "expect": "To release energy from the food or glucose stored inside our cells.",
        "hint": "Think about what your muscle cells are burning to keep you running.",
        "whyProbe": {
          "askedAs": "open",
          "options": [
            {
              "text": "To release energy from glucose inside cells",
              "correct": true,
              "why": "The oxygen travels to every single cell to break down food and unlock energy."
            },
            {
              "text": "To fill up the lungs so they do not collapse",
              "correct": false,
              "why": "Lungs hold the air, but the demand comes from muscles burning fuel.",
              "followUp": "Where does that oxygen go after leaving the lungs?"
            },
            {
              "text": "To cool down the body temperature",
              "correct": false,
              "why": "Sweating cools us down; oxygen is consumed as chemical fuel in cells.",
              "followUp": "What chemical process is happening inside muscles that uses oxygen?"
            }
          ]
        },
        "workedExample": {
          "steps": [
            {
              "say": "A car burns petrol with air to produce movement.",
              "line": "Petrol + Oxygen -> Motion + Exhaust"
            },
            {
              "say": "Similarly, our cells burn glucose with oxygen to produce usable energy.",
              "line": "Glucose + Oxygen -> Energy + Carbon Dioxide"
            }
          ]
        },
        "alternates": [
          {
            "mode": "everyday",
            "say": "Just like a kitchen gas stove needs oxygen to burn gas and cook food, your cells need oxygen to burn digested food for energy.",
            "line": "Fuel + Oxygen -> Energy"
          },
          {
            "mode": "analogy",
            "say": "Breathing is like the delivery truck bringing fuel cylinders to a factory, while respiration is the factory running its machines on that fuel.",
            "line": "Breathing: gas exchange; Respiration: energy release"
          }
        ]
      },
      "show": [
        "b1_0",
        "b1__runner"
      ],
      "frame": [
        "b1_0",
        "b1__runner"
      ]
    },
    {
      "id": "b1_4",
      "topic": "Breathing versus Respiration",
      "narration": "Breathing is simply taking air in and pushing it out through your lungs.",
