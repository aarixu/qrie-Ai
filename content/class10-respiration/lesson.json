      "narration": "Why does aerobic respiration yield so much more ATP than anaerobic respiration?",
      "ask": {
        "question": "Why does aerobic respiration yield so much more ATP than anaerobic respiration?",
        "expect": "Because glucose is completely oxidised or broken down into carbon dioxide and water in the presence of oxygen.",
        "hint": "Think about whether the glucose molecule is broken down completely or only partially.",
        "whyProbe": {
          "askedAs": "open",
          "options": [
            {
              "text": "Glucose is completely broken down in the presence of oxygen",
              "correct": true,
              "why": "Oxygen allows complete oxidation of carbon bonds all the way to carbon dioxide, releasing all stored chemical energy."
            },
            {
              "text": "Oxygen itself contains all the energy",
              "correct": false,
              "why": "Energy comes from chemical bonds in glucose; oxygen is just the electron acceptor that lets it break down fully.",
              "followUp": "Does the energy come from oxygen or from the bonds in food?"
            },
            {
              "text": "Anaerobic respiration destroys the energy",
              "correct": false,
              "why": "Energy is never destroyed; in anaerobic pathways, most of the energy remains trapped in unoxidised products like ethanol or lactic acid.",
              "followUp": "Where is the remaining energy trapped when glucose is not fully oxidised?"
            }
          ]
        },
