    {
      "id": "beat_1_open_4",
      "topic": "The mystery of drying water",
      "narration": "Today we are going to see how liquids change into vapor without ever boiling, and why this simple process cools down your surroundings.",
      "ask": {
        "question": "Where did the liquid water go when it disappeared from the table?",
        "options": [
          {
            "text": "It turned into water vapor and mixed into the surrounding air",
            "correct": true,
            "why": "The surface particles gained enough kinetic energy to leave the liquid and mix into the air as vapor."
          },
          {
            "text": "It seeped completely inside the solid wood or floor",
            "why": "While porous surfaces absorb some, water vanishes even from smooth glass and metal because it enters the air as vapor.",
            "hint": "Think about wet clothes hanging on a plastic line in open air."
          },
          {
            "text": "It was destroyed and ceased to exist",
            "why": "Matter cannot be destroyed; the liquid particles simply changed state into gas.",
            "hint": "Recall that matter is conserved and merely changes its physical state."
          }
        ]
      },
