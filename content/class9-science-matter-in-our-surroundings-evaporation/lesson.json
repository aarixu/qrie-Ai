      "y": 390,
      "text": "Definition of Evaporation",
      "size": 19
    },
    {
      "kind": "text",
      "id": "beat_2_particle_level_10_b0",
      "x": 3020,
      "y": 430,
      "text": "The phenomenon of change of a liquid into vapors at any temperature below its boiling point is called evaporation.",
      "size": 12.643678160919542
    },
    {
      "kind": "list",
      "id": "beat_2_particle_level_11",
      "x": 3927.4,
      "y": 164.41000000000003,
      "w": 705.1999999999999,
      "heading": "Key characteristics of evaporation",
      "items": [
        {
          "term": "Surface phenomenon",
          "meaning": "takes place only at the exposed liquid surface"
        },
        {
          "term": "Occurs at any temperature",
          "meaning": "happens well below the boiling point"
        },
        {
          "term": "Kinetic energy difference",
          "meaning": "only particles with higher energy escape"
        }
      ]
    },
    {
      "kind": "handwrite",
      "id": "beat_2_particle_level_12",
      "x": 4280,
      "y": 446.99,
      "text": "Boiling is a bulk phenomenon; Evaporation is a surface phenomenon",
      "size": 21.44297082228117
    },
