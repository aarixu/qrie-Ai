      "y": 150,
      "w": 705.1999999999999,
      "heading": "Four Chambers & Key Structures",
      "items": [
        {
          "term": "Atria (Top)",
          "meaning": "Thin-walled receiving chambers collecting blood from veins"
        },
        {
          "term": "Ventricles (Bottom)",
          "meaning": "Thick-walled pumping chambers pushing blood out through arteries"
        },
        {
          "term": "Septum",
          "meaning": "Muscular wall preventing oxygenated and deoxygenated blood from mixing"
        },
        {
          "term": "Valves",
          "meaning": "One-way flaps ensuring blood flows forward without backflow"
        }
      ]
    },
