      "items": [
        {
          "term": "Atomic Neutrality",
          "meaning": "Equal number of positive protons and negative electrons"
        },
        {
          "term": "Mass Distribution",
          "meaning": "Protons and neutrons give the atom mass; electrons have negligible mass"
        },
        {
          "term": "Empty Space",
          "meaning": "Most of the volume inside an atom is empty space between nucleus and electrons"
        }
      ]
