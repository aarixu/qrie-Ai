    {
      "kind": "handwrite",
      "id": "beat_2_fixed_vs_variable_9",
      "x": 4280,
      "y": 258.78,
      "text": "If you boil two beakers of sugar water—one with 5 g sugar and one with 50 g sugar—will they boil at the exact same temperature?",
      "size": 17,
      "tone": "accent"
    },
    {
      "kind": "list",
      "id": "beat_2_fixed_vs_variable_10",
      "x": 3927.4,
      "y": 303.38,
      "w": 705.1999999999999,
      "items": [
        {
          "term": "A",
          "meaning": "Yes, all liquid mixtures boil at a fixed point like pure water."
        },
        {
          "term": "B",
          "meaning": "No, the boiling point varies depending on how much sugar is dissolved."
        }
      ]
    },
    {
      "kind": "list",
      "id": "beat_2_fixed_vs_variable_11",
      "x": 5187.4,
