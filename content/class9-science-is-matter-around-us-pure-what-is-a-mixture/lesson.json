      "heading": "Comparing Pure Substances and Mixtures",
      "items": [
        {
          "term": "Pure Substance",
          "meaning": "Single type of particle with fixed composition and sharp, definite properties"
        },
        {
          "term": "Mixture",
          "meaning": "Contains two or more substances in any proportion, with variable properties"
        }
      ]
    },
