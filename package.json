{
  "name": "ai-tutor",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @ai-tutor/classroom",
    "build": "npm run build --workspace @ai-tutor/classroom",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "style-card": "node tools/teacher-clone/src/style-card.ts",
    "app:sync": "npm run build && npm run --workspace @ai-tutor/classroom cap:sync",
    "app:android": "npm run app:sync && npm run --workspace @ai-tutor/classroom cap:android",
    "app:icons": "node tools/bin/make-app-icons.mjs && npm run --workspace @ai-tutor/classroom cap:assets",
    "relay:login": "supabase login",
    "relay:link": "supabase link --project-ref ueemqirxyrltdmqgnidy",
    "relay:secrets": "node tools/bin/relay-secrets.mjs",
    "relay:deploy": "npm run relay:secrets && supabase db push && supabase functions deploy relay --no-verify-jwt",
    "relay:verify": "node tools/bin/verify-deploy.mjs && node tools/bin/live-test.mjs",
    "model:verify": "node tools/bin/model-live-test.mjs",
    "model:metric": "node tools/bin/model-metric.mjs"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.522",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "jsdom": "^26.1.0",
    "supabase": "^2.116.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  }
}
