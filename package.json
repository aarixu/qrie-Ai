{
  "name": "ai-tutor",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @ai-tutor/classroom",
    "build": "npm run build --workspace @ai-tutor/classroom",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "agent:worker": "npm run worker --workspace @ai-tutor/agent",
    "agent:token": "npm run token --workspace @ai-tutor/agent",
    "livekit:server": "node tools/livekit/src/cli.ts",
    "style-card": "node tools/teacher-clone/src/style-card.ts"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.522",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "jsdom": "^26.1.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  }
}
