{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/tests/**/*",
    "apps/*/src/**/*",
    "apps/*/tests/**/*",
    "tools/**/*.ts",
    "supabase/tests/**/*",
    "vitest.config.ts"
  ],
  "exclude": [
    "apps/lms/**"
  ]
}
