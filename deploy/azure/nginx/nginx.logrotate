# Written by deploy/azure/setup-server.sh as /etc/logrotate.d/nginx, in place
# of the file Ubuntu's nginx package ships, to keep nginx's logs for longer:
# rotated daily, the newest 180 old logs kept (CERT-In's directions of 2022
# ask for 180 days), each compressed from its second day (delaycompress). A
# day whose log is empty is not rotated (notifempty), so the 180 can reach
# back further than 180 days.
/var/log/nginx/*.log {
	daily
	missingok
	rotate 180
	compress
	delaycompress
	notifempty
	create 0640 www-data adm
	sharedscripts
	postrotate
		# USR1 makes nginx open its log files again, the new empty ones.
		if [ -s /run/nginx.pid ]; then kill -USR1 "$(cat /run/nginx.pid)"; fi
	endscript
}
