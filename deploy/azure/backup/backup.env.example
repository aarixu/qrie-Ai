# /etc/qrie/backup.env: the settings of qrie-backup.service. Placeholders only;
# never commit the real file. Make it root-only:
#   sudo install -m 0600 -o root -g root /etc/qrie/backup.env.example /etc/qrie/backup.env
#   sudo nano /etc/qrie/backup.env
# Put each value in single quotes: inside them, systemd takes every character
# as it is, including the & and % of a SAS.

# The database, through Supabase's SESSION pooler (Supavisor, port 5432). The
# VM has IPv4 only, and the project's direct address (db.<ref>.supabase.co)
# answers on IPv6 only unless the IPv4 add-on is bought.
# Where: Supabase dashboard, Connect, "Session pooler". Put the database
# password in place of [YOUR-PASSWORD]. If the password has any of
#   @ : / ? # [ ] % ' \
# write each as %40 %3A %2F %3F %23 %5B %5D %25 %27 %5C, or reset the password
# to letters and digits only.
SUPABASE_DB_URL='postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres'

# The Blob container's address with a SAS that may only Create and Write
# (README.md, "Backups"): https://<account>.blob.core.windows.net/<container>?<sas>
AZURE_BLOB_SAS_URL='https://<account>.blob.core.windows.net/<container>?<sas-token>'

# Optional: an outside monitor's heartbeat address, asked once after each good
# backup, so the monitor can tell you when a night is missed (README.md, step 13).
#BACKUP_HEARTBEAT_URL='https://<your monitor>/<check id>'

# Optional: the schemas left out of the dump, separated by spaces. Unset, the
# script's own list applies (this one). Set to '' to leave nothing out.
#BACKUP_EXCLUDE_SCHEMAS='_analytics _realtime _supavisor realtime net pgsodium pgsodium_masks vault supabase_functions'
