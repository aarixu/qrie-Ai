# Keys for the AUTHORING TOOLS (gen-graph, design-lesson, pull-syllabus).
# Copy to .env.local and fill in. .env.local is never committed, and a real
# environment variable always wins over anything in this file.
#
# NOTE ON WHAT MAY GO THROUGH THESE: authoring tools generate curriculum that
# is committed to this repo, so a free model whose prompts are logged is fine.
# Anything a STUDENT types is a different question and uses a different key —
# see apps/classroom/.env.example.

# Which provider the tools talk to. Blank = openrouter.
LLM_PROVIDER=

# OpenRouter — one key, every model. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Blank = stealth/ox-alpha (free, 1M context, JSON mode).
OPENROUTER_MODEL=

# Ox Alpha reasons at "max" unless told otherwise, which turns a 158-chapter
# run into hours of thinking about a schema-shaped extraction. Blank = low.
OPENROUTER_REASONING_EFFORT=

# Only needed when LLM_PROVIDER=gemini. GEMINI_API_KEY is accepted instead.
GOOGLE_API_KEY=

# Only needed when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
