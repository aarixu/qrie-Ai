# Keys for the AUTHORING TOOLS (gen-graph, design-lesson, pull-syllabus).
# Copy to .env.local and fill in. .env.local is never committed, and a real
# environment variable always wins over anything in this file.
#
# NOTE ON WHAT MAY GO THROUGH THESE: authoring tools generate curriculum that
# is committed to this repo, so a free model whose prompts are logged is fine.
# Anything a STUDENT types is a different question and uses a different key —
# see apps/classroom/.env.example.

# Which provider the tools talk to. Blank = openrouter.
LLM_PROVIDER=

# OpenRouter — one key, every model. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Blank = stealth/ox-alpha (free, 1M context, JSON mode).
OPENROUTER_MODEL=

# Ox Alpha reasons at "max" unless told otherwise, which turns a 158-chapter
# run into hours of thinking about a schema-shaped extraction. Blank = low.
OPENROUTER_REASONING_EFFORT=

# Only needed when LLM_PROVIDER=gemini. GEMINI_API_KEY is accepted instead.
GOOGLE_API_KEY=

# Only needed when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# ===========================================================================
# THE APP'S OWN VARIABLES
#
# Vite reads env from THIS directory (vite.config sets envDir to the repo
# root), so everything below belongs in the same .env.local as the keys above.
# There used to be a second file at apps/classroom/.env.local, and the app read
# only one of the two — VITE_SUPABASE_URL sat in this file and never reached
# the browser, so the cloud client was silently null.
#
# Every VITE_ value is inlined into the JavaScript a browser downloads. Only
# put something here if it is safe to publish.
# ===========================================================================
# Gemini API key for the LIVE doubt tutor (https://aistudio.google.com/apikey).
# Without it the app still runs - the doubt session uses a scripted stub.
#
# This is a STUDENT-FACING key and is deliberately not the authoring key in
# /.env.example: students type real questions into this one, and free tiers
# train on what they are sent. Link billing before a child's text reaches it.
#
# The in-class voice is Gemini Live (gemini-3.1-flash-live-preview) over
# Google's own WebSocket - OpenRouter serves text only, so it cannot carry it.
VITE_GEMINI_API_KEY=

# OpenRouter key for the TYPED doubt tutor (https://openrouter.ai/keys).
#
# LOCAL DEVELOPMENT ONLY. Every VITE_ value is inlined into the JavaScript the
# browser downloads, so this key is readable by anyone who opens devtools on a
# deployed build - and an OpenRouter key with no credit limit is a key someone
# else can spend. Set a credit limit on it while it lives here, and move both
# keys behind a server before this app is deployed anywhere public.
# When set it wins over the Gemini key above, which is what keeps typed doubts
# working while a Google project is blocked. It cannot carry the live VOICE -
# OpenRouter serves text only - so speaking to her still needs VITE_GEMINI_API_KEY.
VITE_OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# THE BACKEND THE APP TALKS TO
# ---------------------------------------------------------------------------

# Supabase project. Both are PUBLIC — the anon key is a published identifier,
# and what a student may read or write is decided by row-level security on the
# server, never by hiding this. The service key, which IS a secret, never comes
# near a browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where the relays live.
#
# BLANK IN DEV, and that is the normal setting: the paths stay relative and the
# vite dev server answers them with the same code the deployed function runs.
#
# In production, the deployed Edge Function's base:
#   https://<project-ref>.supabase.co/functions/v1/relay
# Public — it is a URL, and every relay behind it checks who is asking.
VITE_RELAY_URL=

# ---------------------------------------------------------------------------
# CRASH REPORTING AND ANALYTICS — both optional, both a complete no-op unset
# ---------------------------------------------------------------------------
#
# Nothing initialises and no request is ever made while these are blank, which
# is the state the app ships in. lib/telemetry.ts talks to both services over
# plain HTTP rather than through their SDKs — about 55 kB gzipped saved on a
# product whose entry chunk was cut to 122 kB for exactly the phones this is
# for. Swapping to an official SDK later is that one file.
#
# WHAT IS NEVER SENT, whatever these are set to: no transcript, no typed
# doubt, no answer, no free text of any kind, no name, no email, and not the
# Supabase user id. Reports are grouped by a random per-install id that is
# tied to nothing. See the `clean` function, which drops any property longer
# than 64 characters precisely so a sentence cannot become a property.

# Sentry — sentry.io, free tier. Project Settings -> Client Keys (DSN).
# Shaped https://<publicKey>@<host>/<projectId>. Public by design: it can only
# be used to SEND events, which is why it may live in a browser bundle.
VITE_SENTRY_DSN=

# PostHog — posthog.com, free tier. Project Settings -> Project API Key.
# The "phc_..." one, which is public and write-only. Never the personal key.
VITE_POSTHOG_KEY=
# Blank = EU cloud. Use https://us.i.posthog.com for a US project.
VITE_POSTHOG_HOST=

# Stamped on every crash report so one can be traced to a build. Set this in
# CI (a git sha is ideal); blank reads as "dev".
VITE_RELEASE=
