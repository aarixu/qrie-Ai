{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "classroom",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "landing",
        "run",
        "start",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "classroom-localrelay",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace",
        "@ai-tutor/classroom",
        "--",
        "--mode",
        "devrelay",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    }
  ]
}
